{
  "name": "git-workbench",
  "displayName": "Git Workbench",
  "description": "High-performance git workbench with virtual-scrolled commit graph and undo engine",
  "version": "0.1.0",
  "publisher": "git-workbench",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["SCM Providers", "Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitWorkbench.openGraph",
        "title": "Open Commit Graph",
        "category": "Git Workbench",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitWorkbench.undo",
        "title": "Undo Last Operation",
        "category": "Git Workbench",
        "icon": "$(discard)"
      },
      {
        "command": "gitWorkbench.switchBranch",
        "title": "Switch Branch...",
        "category": "Git Workbench",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitWorkbench.createBranch",
        "title": "Create Branch...",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.deleteBranch",
        "title": "Delete Branch...",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.fetch",
        "title": "Fetch",
        "category": "Git Workbench",
        "icon": "$(sync)"
      },
      {
        "command": "gitWorkbench.pull",
        "title": "Pull",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.push",
        "title": "Push",
        "category": "Git Workbench"
      },
      {
        "command": "gitWorkbench.commit",
        "title": "Commit",
        "category": "Git Workbench",
        "icon": "$(check)"
      },
      {
        "command": "gitWorkbench.commitAmend",
        "title": "Amend Last Commit",
        "category": "Git Workbench",
        "icon": "$(edit)"
      },
      {
        "command": "gitWorkbench.stage",
        "title": "Stage Changes",
        "category": "Git Workbench",
        "icon": "$(add)"
      },
      {
        "command": "gitWorkbench.unstage",
        "title": "Unstage Changes",
        "category": "Git Workbench",
        "icon": "$(remove)"
      },
      {
        "command": "gitWorkbench.openResource",
        "title": "Open Changes",
        "category": "Git Workbench"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "gitWorkbench.openGraph",
          "group": "navigation",
          "when": "scmProvider == git-workbench"
        },
        {
          "command": "gitWorkbench.commitAmend",
          "group": "navigation",
          "when": "scmProvider == git-workbench"
        }
      ],
      "scm/resourceState": [
        {
          "command": "gitWorkbench.stage",
          "when": "scmProvider == git-workbench && scmResourceGroup in unstaged,untracked",
          "group": "inline"
        },
        {
          "command": "gitWorkbench.unstage",
          "when": "scmProvider == git-workbench && scmResourceGroup == staged",
          "group": "inline"
        }
      ],
      "scm/resourceState/contextual": [
        {
          "command": "gitWorkbench.stage",
          "when": "scmProvider == git-workbench && scmResourceGroup in unstaged,untracked",
          "group": "1_workbench@1"
        },
        {
          "command": "gitWorkbench.unstage",
          "when": "scmProvider == git-workbench && scmResourceGroup == staged",
          "group": "1_workbench@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gitWorkbench.openGraph"
        },
        {
          "command": "gitWorkbench.commit",
          "when": "false"
        },
        {
          "command": "gitWorkbench.commitAmend",
          "when": "git-workbench:active"
        },
        {
          "command": "gitWorkbench.stage",
          "when": "false"
        },
        {
          "command": "gitWorkbench.unstage",
          "when": "false"
        },
        {
          "command": "gitWorkbench.openResource",
          "when": "false"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "gitWorkbench.graph",
          "name": "Commit Graph",
          "when": "git-workbench:active",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitWorkbench",
          "title": "Git Workbench",
          "icon": "$(source-control)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "package-all": "bash ../scripts/package-all.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0"
  }
}
