{
  "name": "git-bamboo",
  "displayName": "Git Bamboo",
  "description": "High-performance git workbench with virtual-scrolled commit graph and undo engine",
  "version": "0.1.0",
  "publisher": "pandas-coding",
  "engines": {
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pandas-coding/git-bamboo"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitBamboo.openGraph",
        "title": "Open Commit Graph",
        "category": "Git Bamboo",
        "icon": "$(git-branch)"
      },
      {
        "command": "gitBamboo.undo",
        "title": "Undo Last Operation",
        "category": "Git Bamboo",
        "icon": "$(discard)"
      },
      {
        "command": "gitBamboo.switchBranch",
        "title": "Switch Branch...",
        "category": "Git Bamboo",
        "icon": "$(git-compare)"
      },
      {
        "command": "gitBamboo.createBranch",
        "title": "Create Branch...",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.deleteBranch",
        "title": "Delete Branch...",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.fetch",
        "title": "Fetch",
        "category": "Git Bamboo",
        "icon": "$(sync)"
      },
      {
        "command": "gitBamboo.pull",
        "title": "Pull",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.push",
        "title": "Push",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.commit",
        "title": "Focus Commit View",
        "category": "Git Bamboo",
        "icon": "$(check)"
      },
      {
        "command": "gitBamboo.commitAmend",
        "title": "Amend Last Commit",
        "category": "Git Bamboo",
        "icon": "$(edit)"
      },
      {
        "command": "gitBamboo.refreshChanges",
        "title": "Refresh Changes",
        "category": "Git Bamboo",
        "icon": "$(refresh)"
      },
      {
        "command": "gitBamboo.graph.copySha",
        "title": "Copy Commit SHA",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.graph.copyMessage",
        "title": "Copy Commit Message",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.graph.createBranchAt",
        "title": "Create Branch at Commit...",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.graph.checkoutNewBranch",
        "title": "Checkout Commit (New Branch)...",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.commitView.openChanges",
        "title": "Open Changes",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.commitView.stageFile",
        "title": "Stage Changes",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.commitView.unstageFile",
        "title": "Unstage Changes",
        "category": "Git Bamboo"
      },
      {
        "command": "gitBamboo.commitView.copyPath",
        "title": "Copy Path",
        "category": "Git Bamboo"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "gitBamboo.refreshChanges",
          "when": "view == gitBamboo.commit",
          "group": "navigation"
        },
        {
          "command": "gitBamboo.commitAmend",
          "when": "view == gitBamboo.commit",
          "group": "navigation"
        },
        {
          "command": "gitBamboo.undo",
          "when": "view == gitBamboo.graph",
          "group": "navigation"
        },
        {
          "command": "gitBamboo.fetch",
          "when": "view == gitBamboo.commit",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "gitBamboo.openGraph"
        },
        {
          "command": "gitBamboo.commit",
          "when": "git-bamboo:active"
        },
        {
          "command": "gitBamboo.commitAmend",
          "when": "git-bamboo:active"
        },
        {
          "command": "gitBamboo.graph.copySha",
          "when": "false"
        },
        {
          "command": "gitBamboo.graph.copyMessage",
          "when": "false"
        },
        {
          "command": "gitBamboo.graph.createBranchAt",
          "when": "false"
        },
        {
          "command": "gitBamboo.graph.checkoutNewBranch",
          "when": "false"
        },
        {
          "command": "gitBamboo.commitView.openChanges",
          "when": "false"
        },
        {
          "command": "gitBamboo.commitView.stageFile",
          "when": "false"
        },
        {
          "command": "gitBamboo.commitView.unstageFile",
          "when": "false"
        },
        {
          "command": "gitBamboo.commitView.copyPath",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "gitBamboo.graph.checkoutNewBranch",
          "when": "webviewSection == commitRow && (webviewId == gitBamboo.graph || webviewId == gitBamboo.graphPanel)",
          "group": "1_checkout"
        },
        {
          "command": "gitBamboo.graph.createBranchAt",
          "when": "webviewSection == commitRow && (webviewId == gitBamboo.graph || webviewId == gitBamboo.graphPanel)",
          "group": "2_branch"
        },
        {
          "command": "gitBamboo.graph.copySha",
          "when": "webviewSection == commitRow && (webviewId == gitBamboo.graph || webviewId == gitBamboo.graphPanel)",
          "group": "9_clipboard@1"
        },
        {
          "command": "gitBamboo.graph.copyMessage",
          "when": "webviewSection == commitRow && (webviewId == gitBamboo.graph || webviewId == gitBamboo.graphPanel)",
          "group": "9_clipboard@2"
        },
        {
          "command": "gitBamboo.commitView.stageFile",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileChanges",
          "group": "1_stage"
        },
        {
          "command": "gitBamboo.commitView.stageFile",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileUntracked",
          "group": "1_stage"
        },
        {
          "command": "gitBamboo.commitView.unstageFile",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileStaged",
          "group": "1_stage"
        },
        {
          "command": "gitBamboo.commitView.openChanges",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileChanges",
          "group": "2_open"
        },
        {
          "command": "gitBamboo.commitView.openChanges",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileUntracked",
          "group": "2_open"
        },
        {
          "command": "gitBamboo.commitView.openChanges",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileStaged",
          "group": "2_open"
        },
        {
          "command": "gitBamboo.commitView.copyPath",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileChanges",
          "group": "9_clipboard"
        },
        {
          "command": "gitBamboo.commitView.copyPath",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileUntracked",
          "group": "9_clipboard"
        },
        {
          "command": "gitBamboo.commitView.copyPath",
          "when": "webviewId == gitBamboo.commit && webviewSection == fileStaged",
          "group": "9_clipboard"
        }
      ]
    },
    "views": {
      "gitBamboo": [
        {
          "id": "gitBamboo.commit",
          "name": "Commit",
          "when": "git-bamboo:active",
          "type": "webview"
        },
        {
          "id": "gitBamboo.graph",
          "name": "Commit Graph",
          "when": "git-bamboo:active",
          "type": "webview"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitBamboo",
          "title": "Git Bamboo",
          "icon": "$(git-branch)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "node build.js",
    "watch": "node build.js --watch",
    "build": "node build.js",
    "typecheck": "tsc --noEmit",
    "package": "vsce package",
    "package-all": "bash ../../scripts/package-all.sh"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.0"
  }
}
